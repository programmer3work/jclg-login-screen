# Local PostgreSQL example. This project must use its own dedicated JCLG login database.
# Never reuse the AI Student Analysis database for this module.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/jclg_initial_login_local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=16000
BACKEND_PUBLIC_URL=http://127.0.0.1:16000
FRONTEND_PUBLIC_URL=http://127.0.0.1:15000
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DURATION_MINUTES=30
GOOGLE_CLIENT_ID=
GOOGLE_SCOPES=openid email profile
AUTO_ASSIGN_ROLE_CODES=ADMIN,PRINCIPAL,FACULTY,STUDENT,PARENT
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_MINUTES=5
OTP_CHANNEL=sms
