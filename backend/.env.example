# Local PostgreSQL example. For AWS RDS, replace the host and add ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/jclg_ai_student_analysis
BACKEND_HOST=127.0.0.1
BACKEND_PORT=16000
BACKEND_PUBLIC_URL=http://127.0.0.1:16000
FRONTEND_PUBLIC_URL=http://127.0.0.1:15000
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DURATION_MINUTES=30
GOOGLE_CLIENT_ID=
GOOGLE_SCOPES=openid email profile
AUTO_ASSIGN_ROLE_CODES=STUDENT
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRY_MINUTES=5
OTP_CHANNEL=sms
